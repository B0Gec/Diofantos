use P ::= QQ[an, an_1, an_2];

i1 := ideal(an-1, an_1-1, an_2);
i2 := ideal(an-2, an_1-1, an_2-1);
i3 := ideal(an-3, an_1-2, an_2-1);
i4 := ideal(an-5, an_1-3, an_2-2);
i5 := ideal(an-8, an_1-5, an_2-3);
i6 := ideal(an-13, an_1-8, an_2-5);
i7 := ideal(an-21, an_1-13, an_2-8);


i1;
i2;
i1*i2;
GBasis(i1*i2);
ideal(GBasis(i1*i2));
GBasis(ideal(GBasis(i1*i2))*i3);
//GBasis(i1*i2)*i3;

GBasis(i1*i2*i3);
GBasis(i1*i3);
GBasis(i2*i3);
GBasis(i1*i2*i3*i4);
GBasis(i1*i2*i3*i4*i5);
GBasis(i1*i2*i3*i4*i5*i6);
GBasis(i1*i6);
GBasis(i1*i2*i3*i4*i5*i6*i7);
GBasis(i1*i7);
GBasis(i2*i7);
GBasis(i3*i7);
GBasis(i4*i7);
GBasis(i5*i7);
GBasis(i6*i7);

GBasis(i1*i6);
GBasis(i2*i6);
GBasis(i3*i6);
GBasis(i4*i6);
GBasis(i5*i6);

GBasis(i1*i5);
GBasis(i2*i5);
GBasis(i3*i5);
GBasis(i4*i5);

GBasis(i1*i4);
GBasis(i2*i4);
GBasis(i3*i4);

GBasis(i6*i7);
GBasis(i7*i6);

GBasis(i1*i2);
GBasis(i2*i1);
GBasis(i1*i3);
GBasis(i3*i1);

ideal(x^2 -3*x +2,   x*z -x -z +1,
     x*z -2*z,  y-1,  z^2 -z)