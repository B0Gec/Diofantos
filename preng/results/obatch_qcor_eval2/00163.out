def calculate_sequence(n):
    if n == 0:
        return 2

    prev = calculate_sequence(n - 1)
    current = prev + 1

    while True:
        if is_prime_power(current):
            return current
        current += 1

def is_prime_power(x):
    if x < 2:
        return False
    for i in range(2, int(x**0.5) + 1):
        if x % i == 0:
            return False
    return True
 





