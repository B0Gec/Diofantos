from functools import lru_cache

@lru_cache(maxsize=None)
def partition_number(n):
    if n < 0:
        return 0
    if n == 0:
        return 1
    total = 0
    k = 1
    while True:
        g1 = (3 * k * k - k) // 2
        if g1 > n:
            break
        total += (-1) ** (k - 1) * partition_number(n - g1)
        
        g2 = (3 * k * k + k) // 2
        if g2 > n:
            break
        total += (-1) ** (k - 1) * partition_number(n - g2)
        
        k += 1
    return total
 





