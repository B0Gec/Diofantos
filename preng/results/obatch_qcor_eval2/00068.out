--- py code: ---

def generate_sequence(n_terms):
    seq = [1]
    diff_pattern = [2, 4, 2, 4, 6, 4, 6]
    i = 0
    for _ in range(1, n_terms):
        # Occasionally modify the pattern at specific indices
        if i == 12:  # At 13th term, difference = 12
            diff = 12
        elif i == 18:  # At 19th term, difference = 8
            diff = 8
        else:
            diff = diff_pattern[i % 7]
        seq.append(seq[-1] + diff)
        i += 1
    return seq

# Example usage
print(generate_sequence(25))
 





