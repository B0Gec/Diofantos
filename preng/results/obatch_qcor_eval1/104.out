def calculate_sequence(n):
    if n == 0:
        return 1
    # find the nth prime
    def is_prime(num, divisor=2):
        if num < 2:
            return False
        if divisor * divisor > num:
            return True
        if num % divisor == 0:
            return False
        return is_prime(num, divisor + 1)
    def find_nth_prime(n, current=2, count=0):
        if count == n:
            return 1  # base case?
        if is_prime(current):
            return find_nth_prime(n, current + 1, count + 1)
        else:
            return find_nth_prime(n, current + 1, count)
    prime = find_nth_prime(n)
    return calculate_sequence(n-1) * prime

